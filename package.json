{
  "name": "@usestring/cli",
  "version": "0.1.0",
  "description": "Command-line access to String Web Access",
  "keywords": ["web-access", "web-scraping", "search", "cli"],
  "type": "module",
  "bin": {
    "string": "dist/cli.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "bun build src/cli.ts --target=node --outdir=dist",
    "prepack": "bun run build",
    "test": "bun test",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/bun": "1.3.14",
    "@types/node": "25.2.3",
    "typescript": "5.9.3"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/usestring/cli.git"
  },
  "packageManager": "bun@1.3.10",
  "license": "MIT"
}
